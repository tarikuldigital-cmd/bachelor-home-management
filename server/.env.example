# Copy this file to .env and fill in
PORT=4000
JWT_SECRET=put-a-long-random-secret-here
DATA_FILE=./data/db.json
CORS_ORIGIN=*

# First manager account (created only when the database is new)
MESS_NAME=Bachelor Home
ADMIN_USERNAME=manager
ADMIN_PASSWORD=1234
ADMIN_NAME=Manager
ADMIN_PHONE=

# SMS gateway: bulksmsbd | template | none
SMS_PROVIDER=bulksmsbd
SMS_API_KEY=
SMS_SENDER_ID=
# For any other gateway (SMS_PROVIDER=template):
# SMS_URL_TEMPLATE=https://example.com/api/send?apikey=XXX&to={number}&text={message}
